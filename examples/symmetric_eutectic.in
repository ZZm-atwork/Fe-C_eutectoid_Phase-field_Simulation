# Pearl v0.4 input: annotated without changing any existing key or value.
# Syntax: key = value; # starts a comment. Duplicate and unknown keys are errors.
# Phase IDs: 0=alpha/ferrite, 1=theta/cementite, 2=gamma/austenite.
# INPUT PARAMETERS configure the model; the separate FILLING sections initialize fields.
# See ../INPUT_PARAMETERS.md (or ../../INPUT_PARAMETERS.md from legacy_direct).
# See FILLING_METHODS.md in the v4_updated root for geometry methods and compatibility.
# SYNTHETIC NONDIMENSIONAL BENCHMARK: all displayed SI-unit annotations below
# describe the dimensional model convention; this example uses consistent model units.
# It is not an Fe-C material parameter set. temperature=1.0 is its explicit label.

# ============================================================================
# INPUT PARAMETERS: TEMPERATURE AND THERMODYNAMIC CONVENTION
# ============================================================================
# Thermodynamic input convention: reference-temperature ABC, or ABC already at the run temperature.
thermo_mode = direct_at_temperature
# Run temperature [K] in direct mode; ABC already apply here, so no temperature correction is added.
temperature = 1.0

# ============================================================================
# INPUT PARAMETERS: FERRITE (ALPHA) THERMODYNAMICS AND DIFFUSIVITY
# ============================================================================
# Ferrite run-temperature free-energy coefficient of c^2 in f(c,T)=A*c^2+B*c+C [J/mol].
A_alpha = 1
# Ferrite run-temperature free-energy coefficient of c in f(c,T)=A*c^2+B*c+C [J/mol].
B_alpha = -0.5
# Ferrite run-temperature free-energy constant term in f(c,T)=A*c^2+B*c+C [J/mol].
C_alpha = 0.0375
# Ferrite carbon diffusivity [m^2/s]; used in K=sum(phi*D*dc/dmu).
D_alpha = 0.1

# ============================================================================
# INPUT PARAMETERS: CEMENTITE (THETA) THERMODYNAMICS AND DIFFUSIVITY
# ============================================================================
# Cementite run-temperature free-energy coefficient of c^2 in f(c,T)=A*c^2+B*c+C [J/mol].
A_theta = 1
# Cementite run-temperature free-energy coefficient of c in f(c,T)=A*c^2+B*c+C [J/mol].
B_theta = -1.5
# Cementite run-temperature free-energy constant term in f(c,T)=A*c^2+B*c+C [J/mol].
C_theta = 0.5375
# Cementite carbon diffusivity [m^2/s]; used in K=sum(phi*D*dc/dmu).
D_theta = 0.1

# ============================================================================
# INPUT PARAMETERS: AUSTENITE (GAMMA) THERMODYNAMICS AND DIFFUSIVITY
# ============================================================================
# Austenite run-temperature free-energy coefficient of c^2 in f(c,T)=A*c^2+B*c+C [J/mol].
A_gamma = 1
# Austenite run-temperature free-energy coefficient of c in f(c,T)=A*c^2+B*c+C [J/mol].
B_gamma = -1
# Austenite run-temperature free-energy constant term in f(c,T)=A*c^2+B*c+C [J/mol].
C_gamma = 0.25
# Austenite carbon diffusivity [m^2/s]; used in K=sum(phi*D*dc/dmu).
D_gamma = 1

# ============================================================================
# INPUT PARAMETERS: COMPUTATIONAL GRID
# ============================================================================
# Number of physical cells along x; x is periodic. Total width = nx*dx.
nx = 64
# Number of physical cells along y; y has no-flux boundaries. Total height = ny*dy.
ny = 80
# Cell spacing along x [m]; this is resolution, not a phase-layer width.
dx = 0.2
# Cell spacing along y [m]; omitted dy defaults to dx.
dy = 0.2

# ============================================================================
# INPUT PARAMETERS: INTERFACE ENERGY AND PHASE KINETICS
# ============================================================================
# Common molar volume [m^3/mol]; converts the molar chemical driving force to energy density.
Vm = 1
# Diffuse-interface model length [m]; not the measured 10%-90% interface width.
epsilon = 0.6
# Equal interfacial energy for all three phase pairs [J/m^2].
sigma = 0.02
# Three-phase overlap energy coefficient [J/m^2]; penalizes overlap without forbidding a triple junction.
triple = 0.4
# Alpha-theta phase relaxation coefficient [J*s/m^4]; retained explicitly, not fitted automatically.
tau_at = 1
# Alpha-gamma phase relaxation coefficient [J*s/m^4]; retained explicitly, not fitted automatically.
tau_ag = 1
# Theta-gamma phase relaxation coefficient [J*s/m^4]; retained explicitly, not fitted automatically.
tau_tg = 1

# ============================================================================
# INPUT PARAMETERS: PHYSICAL TIME AND OUTPUT
# ============================================================================
# Initial trial time step [s]; adaptive acceptance and output-time clipping can change accepted dt.
dt = 0.01
# Upper cap on subsequent proposed time steps [s]; default is dt.
dt_max = 0.02
# Lower limit for trial time steps [s]; default is dt/1048576.
dt_min = 1e-8
# Absolute physical stopping time [s], including time already stored in a restart checkpoint.
end_time = 30
# Field/checkpoint output interval in physical time [s]; the integrator clips steps to output times.
output_dt = 1

# ============================================================================
# FILLING: INITIAL PHASE GEOMETRY
# ============================================================================
# Native choices: lamella, sharp_smooth, flat, circle.
# For the current lamellar seed: theta occupies the first theta_columns;
# alpha occupies the rest below seed_height; gamma occupies the region above.
# Other shapes and their arguments are described in INPUT_PARAMETERS.md.
# Initial phase geometry; lamella uses the analytic diffuse profile directly (no sharp_smooth stage).
initialization = lamella
# Seed top height measured from y=0 [m]; cell centers below this height are product in sharp_smooth.
seed_height = 4
# Theta width in x cells for the product seed; remaining seed columns are alpha.
theta_columns = 32

# ============================================================================
# FILLING: INITIAL CARBON / CHEMICAL POTENTIAL
# ============================================================================
# Carbon atomic fraction assigned to pure gamma to set one uniform initial chemical potential; not wt%.
gamma_carbon = 0.5
